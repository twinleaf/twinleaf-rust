# gradiometer.tsl, with the rate match forgotten.
source a = /0/field @rate(1000) @channels(x, y, z) @unit(nT)
source b = /1/field @rate(500) @channels(x, y, z) @unit(nT)
source c = /2/field @rate(44100) @channels(x, y, z) @unit(nT)

let fr = align(a, b)
let three = align(
    slow = b | lowpass(10),
    a,
    c)
