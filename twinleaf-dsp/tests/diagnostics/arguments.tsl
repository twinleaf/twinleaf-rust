source a = /0/field @rate(1000) @channels(x, y, z) @unit(nT)
source b = /1/field @rate(1000) @channels(x, y, z) @unit(nT)
let n1 = a | notch(60, width = 2)
let n2 = a | notch(60, 30, 2, causal, 9)
let n3 = a | notch(60, f = 50)
let n4 = a | bandpass(order = 2)
let n5 = align(a)
let n6 = align(a - a, b)
let n7 = align(a | lowpass(10), a)
let n8 = decorrelate(a, method = ls)
